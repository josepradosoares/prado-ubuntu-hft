# Prado Ubuntu HFT — Variáveis de Ambiente (Placeholders)
# NUNCA coloque tokens ou segredos reais neste arquivo ou no Git.
# Copie para .env local (ignorado pelo Git) ou configure via painel web ("Configuração cTrader").

# Domínio público HTTPS (DuckDNS) e portas do proxy reverso Nginx + backend Python
PRADO_DOMAIN=paineljose.duckdns.org
PRADO_WEB_PORT=8080
PRADO_INTERNAL_PORT=8081
# Opcional: e-mail para alertas de renovação Let's Encrypt
PRADO_CERTBOT_EMAIL=

# Credenciais do seu App criado em https://openapi.ctrader.com/apps
CTRADER_CLIENT_ID=seu_client_id_de_openapi_ctrader_com
CTRADER_CLIENT_SECRET=seu_client_secret_de_openapi_ctrader_com

# URI de callback OAuth 2.0 cadastrada no portal cTrader
CTRADER_REDIRECT_URI=https://paineljose.duckdns.org/api/ctrader/oauth/callback

# Opcional: Access Token e Refresh Token obtidos via OAuth / Playground cTrader
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# Tipo de conta padrão (DEMO recomendado; REAL bloqueada por padrão)
CTRADER_ACCOUNT_TYPE=DEMO

# Trava de segurança para conta REAL (manter false por padrão)
ALLOW_REAL_TRADING=false

# Supabase (Persistência Multi-Usuário + Auth)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_ou_publishable_key_aqui
SUPABASE_SERVICE_ROLE_KEY=opcional_service_role_key_aqui
