# Prado Ubuntu HFT — Variáveis de Ambiente (Placeholders)
# NUNCA coloque tokens reais neste arquivo ou no Git.
# Copie para .env local (ignorado pelo Git) ou configure via painel web ("Tokens e Contas").

# App ID gerado para sua aplicação PAT em https://developers.deriv.com
# ATENÇÃO: O App ID legado 1089 NÃO é aceito para tokens pat_...
DERIV_APP_ID=seu_app_id_de_developers_deriv_com

# Personal Access Token (PAT) gerado em https://developers.deriv.com (escopos: trade, account_manage)
DERIV_TOKEN=pat_seu_token_pessoal_aqui

# Tipo de conta padrão (DEMO recomendado; REAL bloqueada por padrão)
DERIV_ACCOUNT_TYPE=DEMO

# Trava de segurança para conta REAL (manter false por padrão)
ALLOW_REAL_TRADING=false

# Porta HTTP do painel web Python
PRADO_WEB_PORT=8080

# Supabase (Persistência Multi-Usuário + Auth)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_ou_publishable_key_aqui
SUPABASE_SERVICE_ROLE_KEY=opcional_service_role_key_aqui
